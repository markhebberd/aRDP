+JNIEXPORT jboolean JNICALL
+Java_com_freerdp_freerdpcore_services_LibFreeRDP_freerdp_1send_1resize_1event(
+    JNIEnv* env, jclass cls, jlong instance, jint width, jint height)
+{
+	freerdp* inst = (freerdp*)instance;
+
+	if (!inst || !inst->context)
+		return JNI_FALSE;
+
+	androidContext* ctx = (androidContext*)inst->context;
+
+	if (!ctx->disp || !ctx->dispActivated)
+	{
+		WLog_WARN(TAG, "send_resize_event: disp channel not ready");
+		return JNI_FALSE;
+	}
+
+	DISPLAY_CONTROL_MONITOR_LAYOUT layout = { 0 };
+	layout.Flags = DISPLAY_CONTROL_MONITOR_PRIMARY;
+	layout.Top = 0;
+	layout.Left = 0;
+	layout.Width = (UINT32)width;
+	layout.Height = (UINT32)height;
+	layout.PhysicalWidth = (UINT32)width;
+	layout.PhysicalHeight = (UINT32)height;
+	layout.Orientation = ORIENTATION_LANDSCAPE;
+	layout.DesktopScaleFactor = 100;
+	layout.DeviceScaleFactor = 100;
+
+	WLog_INFO(TAG, "send_resize_event: %dx%d", width, height);
+
+	UINT rc = IFCALLRESULT(CHANNEL_RC_OK, ctx->disp->SendMonitorLayout, ctx->disp, 1, &layout);
+	return (rc == CHANNEL_RC_OK) ? JNI_TRUE : JNI_FALSE;
+}
